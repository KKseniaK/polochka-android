<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_month_stats"
    android:padding="20dp">

    <TextView
        android:id="@+id/monthTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/home_month_stats_title"
        android:textAllCaps="true"
        android:textColor="@color/background_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/leftStatsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/monthTitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightStatsContainer"
        app:layout_constraintWidth_percent="0.5">

        <TextView
            android:id="@+id/savedProductsLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_saved_products"
            android:textColor="@color/background_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/savedProductsValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/background_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="25%" />

        <TextView
            android:id="@+id/savedProductsSubTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_products_suffix"
            android:textColor="@color/background_primary"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightStatsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/monthTitleTextView"
        app:layout_constraintStart_toEndOf="@id/leftStatsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <TextView
            android:id="@+id/savedMoneyLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_saved_money"
            android:textColor="@color/background_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/savedMoneyValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/background_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="5000 руб" />

    </LinearLayout>

    <TextView
        android:id="@+id/monthStatsEmptyTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/home_month_stats_empty_message"
        android:textColor="@color/background_primary"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/rightStatsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
