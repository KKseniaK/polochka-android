<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/analyticsInsightsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <include
        android:id="@+id/topLeftInsight"
        layout="@layout/item_analytics_insight"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/topRightInsight" />

    <include
        android:id="@+id/topRightInsight"
        layout="@layout/item_analytics_insight"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="@id/topLeftInsight"
        app:layout_constraintStart_toEndOf="@id/topLeftInsight"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/championAvatarImageView"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_avatar_placeholder"
        android:contentDescription="@string/content_description_profile_photo"
        android:padding="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile_placeholder"
        app:layout_constraintTop_toBottomOf="@id/topLeftInsight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@drawable/ic_profile_placeholder" />

    <ImageView
        android:id="@+id/crownImageView"
        android:layout_width="42dp"
        android:layout_height="32dp"
        android:layout_marginBottom="-4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_crown"
        app:layout_constraintBottom_toTopOf="@id/championAvatarImageView"
        app:layout_constraintStart_toStartOf="@id/championAvatarImageView"
        app:layout_constraintEnd_toEndOf="@id/championAvatarImageView" />

    <TextView
        android:id="@+id/championNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/analytics_champion_name_default"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/championAvatarImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/championDescriptionTextView"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/analytics_champion_description"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/championNameTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/bottomLeftInsight"
        layout="@layout/item_analytics_insight"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toBottomOf="@id/championDescriptionTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bottomRightInsight" />

    <include
        android:id="@+id/bottomRightInsight"
        layout="@layout/item_analytics_insight"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="@id/bottomLeftInsight"
        app:layout_constraintStart_toEndOf="@id/bottomLeftInsight"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>