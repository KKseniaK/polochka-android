<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/shape_bottom_menu"
    android:elevation="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="5">

        <!-- STORAGE -->
        <FrameLayout
            android:id="@+id/storageMenuButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/selector_menu_item_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/menu_storage">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_storage"
                android:contentDescription="@null"/>
        </FrameLayout>

        <!-- SHOPPING -->
        <FrameLayout
            android:id="@+id/shoppingMenuButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/selector_menu_item_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/menu_shopping">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shopping"
                android:contentDescription="@null"/>
        </FrameLayout>

        <!-- HOME -->
        <FrameLayout
            android:id="@+id/homeMenuButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/selector_menu_item_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/menu_home">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                android:contentDescription="@null"/>
        </FrameLayout>

        <!-- RECIPES -->
        <FrameLayout
            android:id="@+id/recipesMenuButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/selector_menu_item_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/menu_recipes">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_recipes"
                android:contentDescription="@null"/>
        </FrameLayout>

        <!-- PROFILE -->
        <FrameLayout
            android:id="@+id/profileMenuButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/selector_menu_item_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/menu_profile">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_stats"
                android:contentDescription="@null"/>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>