<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:clipToPadding="false"
    android:paddingBottom="130dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_screen_horizontal"
        android:paddingTop="64dp">

        <TextView
            android:id="@+id/homeTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/settingsButton" />

        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/content_description_settings"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/button_primary"
            app:layout_constraintTop_toTopOf="@id/homeTitleTextView"
            app:layout_constraintBottom_toBottomOf="@id/homeTitleTextView"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/familyRecyclerView"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginTop="18dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/homeTitleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_home_family_member"
            tools:itemCount="4" />

        <View
            android:id="@+id/dividerOne"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_dashed_line"
            app:layout_constraintTop_toBottomOf="@id/familyRecyclerView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/expiringProductsBlock"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_home_expiring_block"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/dividerOne"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/expiringTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_expiring_title"
                android:textAllCaps="true"
                android:textColor="@color/background_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expiringProductsRecyclerView"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="26dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/expiringTitleTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_home_expiring_product"
                tools:itemCount="4" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/dividerTwo"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_dashed_line"
            app:layout_constraintTop_toBottomOf="@id/expiringProductsBlock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/monthStatsBlock"
            layout="@layout/view_month_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/dividerTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/dividerThree"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_dashed_line"
            app:layout_constraintTop_toBottomOf="@id/monthStatsBlock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/homeRecipesTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_recipes_title"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/dividerThree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeRecipesRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/homeRecipesTitleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_recipe_card"
            tools:itemCount="4" />

        <Button
            android:id="@+id/homeShowAllRecipesButton"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/shape_button_primary"
            app:backgroundTint="@null"
            android:text="@string/action_show_all"
            android:textAllCaps="false"
            android:textColor="@color/background_primary"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/homeRecipesRecyclerView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>